rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // Subjects Collection
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // Classes Collection
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
